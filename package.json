{
  "name": "dieftrade",
  "productName": "DiefTrade",
  "version": "0.9.2",
  "description": "Assistente profissional de leitura de mercado e paper trading para day trade de criptomoedas.",
  "author": "Equipe Dief",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env DIEFTRADE_DEV=1 electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ai:live": "node scripts/ai-live-test.cjs",
    "check:static": "node scripts/check.cjs",
    "test:ui": "node scripts/test-interface.cjs",
    "check": "pnpm run check:static && node --test tests/*.test.cjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --dir"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "cross-env": "^10.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "br.com.dief.trade",
    "productName": "DiefTrade",
    "artifactName": "DiefTrade-${version}-${arch}.${ext}",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/brand/dieftrade-coin.png",
      "scripts/smoke-runner.cjs",
      "package.json"
    ],
    "win": {
      "icon": "assets/brand/dieftrade.ico",
      "target": [
        "portable"
      ],
      "legalTrademarks": "DiefTrade"
    }
  }
}
